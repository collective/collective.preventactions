<configure
  xmlns="http://namespaces.zope.org/zope"
  xmlns:browser="http://namespaces.zope.org/browser"
  xmlns:i18n="http://namespaces.zope.org/i18n"
  xmlns:plone="http://namespaces.plone.org/plone"
  xmlns:zcml="http://namespaces.zope.org/zcml"
  i18n_domain="collective.preventactions">

    <include package="plone.behavior" file="meta.zcml"/>

    <plone:behavior
        name="collective.preventactions.prevent_actions"
        title="PreventActions"
        description="This behaviors adds prevent actions on a content type"
        provides=".prevent_actions.IPreventActionsMarker"
        marker=".prevent_actions.IPreventActionsMarker"
        />


</configure>